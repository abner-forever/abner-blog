{
  "realm": "abner-blog",
  "displayName": "Abner Blog",
  "displayNameHtml": "Abner Blog",
  "enabled": true,
  "loginTheme": "abner-login",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "defaultLocale": "zh-CN",
  "supportedLocales": ["zh-CN", "en"],
  "clients": [
    {
      "clientId": "admin-sso",
      "enabled": true,
      "publicClient": false,
      "secret": "your-client-secret",
      "redirectUris": [
        "http://localhost:5177/*",
        "http://localhost:3001/*",
        "http://localhost:8080/api/sso/callback"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "http://localhost:5177"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "id.token.lifespan": "300",
        "post.logout.redirect.uris": "",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@abner-blog.com",
      "firstName": "Admin",
      "lastName": "User",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ]
    }
  ]
}
