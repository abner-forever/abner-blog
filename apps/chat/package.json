    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.12",
    "antd": "^6.3.1",
    "axios": "^1.9.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "fuse.js": "^7.3.0",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.0.5",
    "modern-screenshot": "^4.6.8",
