{
  "name": "@abner-blog/chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "lsof -ti:3002 | xargs kill -9 2>/dev/null; while lsof -ti:3002 >/dev/null 2>&1; do sleep 0.5; done; vite",
